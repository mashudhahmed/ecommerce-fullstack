# API Configuration (Backend on Render)
# Example: https://snapcart-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# WebSocket Configuration (for live chat and order notifications)
# Example: wss://snapcart-backend.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# App Configuration (Frontend on Vercel)
# Example: https://snapcart-store.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Features
NEXT_PUBLIC_ENABLE_2FA=true
