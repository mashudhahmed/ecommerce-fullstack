# Application
NODE_ENV=development
PORT=3000

# Database (Standard Postgres or Neon Postgres)
# Neon connection string example: postgresql://[user]:[password]@[endpoint].neon.tech/ecommerce_db?sslmode=require
DATABASE_URL=
DATABASE_SSL=false
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=ecommerce_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Admin@123456

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# CORS (Frontend URL e.g. https://your-project.vercel.app)
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudinary (Media Storage for Render & Vercel)
# Option 1: Full URL (cloudinary://api_key:api_secret@cloud_name)
CLOUDINARY_URL=
# Option 2: Individual keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=snapcart/products